{
  "name": "skyboy",
  "version": "0.1.0",
  "private": true,
  "description": "Skyboy — a desktop notifier for Claude Code and Codex, and the skyboy.in website.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "lint": "npm --workspace apps/web run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "npm --workspace @skyboy/desktop run tauri:dev",
    "desktop:build": "npm --workspace @skyboy/desktop run tauri:build",
    "desktop:test": "npm --workspace @skyboy/desktop run test",
    "sounds": "npm --workspace @skyboy/desktop run generate:sounds"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
