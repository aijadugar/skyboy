{
  "name": "skyboy",
  "version": "0.1.0",
  "private": true,
  "description": "Skyboy — a desktop notifier for Claude Code and Codex. This repo is the skyboy.in website.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "lint": "npm --workspace apps/web run lint",
    "validate-skills": "go run ./cli validate",
    "build-catalog": "go run ./cli build-catalog",
    "detect-duplicates": "node --experimental-strip-types scripts/detect-duplicates.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
