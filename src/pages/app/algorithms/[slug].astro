---
import AppLayout from "@/layouts/AppLayout.astro";
import { getAlgorithmBySlug, getAllAlgorithms, getRunsByAlgorithm } from "@/lib/mock-data";

export function getStaticPaths() {
  const algorithms = getAllAlgorithms();
  return algorithms.map((alg) => ({
    params: { slug: alg.slug },
    props: { algorithm: alg },
  }));
}

const { algorithm } = Astro.props;
const runs = getRunsByAlgorithm(algorithm.slug);

if (!algorithm) {
  return Astro.redirect("/app/algorithms");
}
---

<AppLayout title={`${algorithm.name} - Skyboy`}>
  <div slot="breadcrumb">
    <nav class="flex items-center gap-2 text-sm">
      <a href="/app/dashboard" class="text-[#8A8A85] hover:text-[#111110]">Dashboard</a>
      <span class="text-[#8A8A85]">/</span>
      <a href="/app/algorithms" class="text-[#8A8A85] hover:text-[#111110]">Algorithms</a>
      <span class="text-[#8A8A85]">/</span>
      <span class="font-medium text-[#111110]">{algorithm.name}</span>
    </nav>
  </div>

  <div class="mb-8 flex items-start justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold text-[#111110]">{algorithm.name}</h1>
        <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${
          algorithm.status === "active" ? "bg-[#D1FAE5] text-[#065F46]" :
          algorithm.status === "deprecated" ? "bg-[#FEE2E2] text-[#991B1B]" :
          "bg-[#F3F4F6] text-[#374151]"
        }`}>
          {algorithm.status}
        </span>
      </div>
      <p class="mt-1 text-sm font-mono text-[#8A8A85]">{algorithm.slug} • v{algorithm.version}</p>
    </div>
    <button class="inline-flex items-center gap-2 rounded-lg border border-black/[0.08] bg-white px-4 py-2.5 text-sm font-medium text-[#4B4B48] transition hover:bg-[#F7F7F5]">
      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
      </svg>
      Run Benchmark
    </button>
  </div>

  <div class="mb-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <p class="text-xs font-medium text-[#8A8A85]">Recall@10</p>
      <p class="mt-2 text-2xl font-semibold text-[#111110]">{algorithm.metrics?.recallAt10.toFixed(3) ?? "—"}</p>
    </div>
    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <p class="text-xs font-medium text-[#8A8A85]">NDCG@10</p>
      <p class="mt-2 text-2xl font-semibold text-[#111110]">{algorithm.metrics?.ndcgAt10.toFixed(3) ?? "—"}</p>
    </div>
    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <p class="text-xs font-medium text-[#8A8A85]">Latency</p>
      <p class="mt-2 text-2xl font-semibold text-[#111110]">{algorithm.metrics?.latencyMs ?? "—"}<span class="text-sm font-normal text-[#8A8A85]">ms</span></p>
    </div>
    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <p class="text-xs font-medium text-[#8A8A85]">Regressions</p>
      <p class="mt-2 text-2xl font-semibold text-[#111110]">{algorithm.metrics?.regressionCount ?? "—"}</p>
    </div>
  </div>

  <div class="mb-8 rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
    <h2 class="text-base font-semibold text-[#111110]">Description</h2>
    <p class="mt-3 text-sm leading-relaxed text-[#4B4B48]">{algorithm.description}</p>
    
    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium text-[#8A8A85]">Author</dt>
        <dd class="mt-1 text-sm font-medium text-[#111110]">{algorithm.author}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-[#8A8A85]">Created</dt>
        <dd class="mt-1 text-sm font-medium text-[#111110]">{new Date(algorithm.createdAt).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-[#8A8A85]">Last Updated</dt>
        <dd class="mt-1 text-sm font-medium text-[#111110]">{new Date(algorithm.updatedAt).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-[#8A8A85]">Version</dt>
        <dd class="mt-1 text-sm font-mono text-[#111110]">{algorithm.version}</dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl border border-black/[0.08] bg-white shadow-sm">
    <div class="border-b border-black/[0.08] px-6 py-4">
      <h2 class="text-base font-semibold text-[#111110]">Recent Runs</h2>
    </div>
    {runs.length > 0 ? (
      <div class="divide-y divide-black/[0.06]">
        {runs.map((run) => (
          <a href={`/app/runs/${run.id}`} class="flex items-center justify-between px-6 py-4 transition hover:bg-[#F7F7F5]">
            <div class="flex items-center gap-4">
              <div class={`flex size-2 rounded-full ${
                run.status === "completed" ? "bg-[#10B981]" :
                run.status === "running" ? "bg-[#F59E0B]" :
                run.status === "failed" ? "bg-[#DC2626]" :
                "bg-[#8A8A85]"
              }`} />
              <div>
                <p class="text-sm font-medium text-[#111110]">{run.datasetName}</p>
                <p class="text-xs text-[#8A8A85]">{run.commitHash} • {new Date(run.startedAt).toLocaleString()}</p>
              </div>
            </div>
            <div class="text-right">
              {run.metrics ? (
                <>
                  <p class="text-sm font-mono font-medium text-[#111110]">{run.metrics.recallAt10.toFixed(3)}</p>
                  <p class="text-xs text-[#8A8A85]">Recall@10</p>
                </>
              ) : (
                <span class="text-xs text-[#8A8A85] capitalize">{run.status}</span>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="px-6 py-12 text-center">
        <p class="text-sm text-[#8A8A85]">No runs yet for this algorithm.</p>
      </div>
    )}
  </div>
</AppLayout>
