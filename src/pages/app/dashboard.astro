---
import AppLayout from "@/layouts/AppLayout.astro";
import { getAllAlgorithms, getAllRuns, getLeaderboardEntries } from "@/lib/mock-data";

const algorithms = getAllAlgorithms();
const recentRuns = getAllRuns().slice(0, 5);
const topLeaderboard = getLeaderboardEntries().slice(0, 5);
---

<AppLayout title="Dashboard - Skyboy">
  <div slot="breadcrumb">
    <nav class="flex items-center gap-2 text-sm">
      <span class="font-medium text-[#111110]">Dashboard</span>
    </nav>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-[#111110]">Welcome back</h1>
    <p class="mt-1 text-sm text-[#4B4B48]">Here's what's happening with your algorithms today.</p>
  </div>

  <!-- Stats overview -->
  <div class="mb-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="flex size-10 items-center justify-center rounded-lg bg-[#F7F7F5]">
          <svg class="size-5 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium text-[#8A8A85]">Total Algorithms</p>
          <p class="text-2xl font-semibold text-[#111110]">{algorithms.length}</p>
        </div>
      </div>
    </div>

    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="flex size-10 items-center justify-center rounded-lg bg-[#F7F7F5]">
          <svg class="size-5 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium text-[#8A8A85]">Runs Today</p>
          <p class="text-2xl font-semibold text-[#111110]">12</p>
        </div>
      </div>
    </div>

    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="flex size-10 items-center justify-center rounded-lg bg-[#F7F7F5]">
          <svg class="size-5 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0V5.625a1.125 1.125 0 011.125-1.125h2.25c1.052 0 2.104.074 3.144.22m-16.5 0a18.196 18.196 0 013.144-.22h2.25c.621 0 1.125.504 1.125 1.125v8.625" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium text-[#8A8A85]">Avg Recall@10</p>
          <p class="text-2xl font-semibold text-[#111110]">0.756</p>
        </div>
      </div>
    </div>

    <div class="rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="flex size-10 items-center justify-center rounded-lg bg-[#F7F7F5]">
          <svg class="size-5 text-[#DC2626]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-medium text-[#8A8A85]">Regressions</p>
          <p class="text-2xl font-semibold text-[#111110]">3</p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Recent runs -->
    <div class="rounded-xl border border-black/[0.08] bg-white shadow-sm">
      <div class="border-b border-black/[0.08] px-6 py-4">
        <h2 class="text-base font-semibold text-[#111110]">Recent Runs</h2>
      </div>
      <div class="divide-y divide-black/[0.06]">
        {recentRuns.map((run) => (
          <a href={`/app/runs/${run.id}`} class="flex items-center justify-between px-6 py-4 transition hover:bg-[#F7F7F5]">
            <div class="flex items-center gap-4">
              <div class={`flex size-2 rounded-full ${
                run.status === "completed" ? "bg-[#10B981]" :
                run.status === "running" ? "bg-[#F59E0B]" :
                run.status === "failed" ? "bg-[#DC2626]" :
                "bg-[#8A8A85]"
              }`} />
              <div>
                <p class="text-sm font-medium text-[#111110]">{run.algorithmName}</p>
                <p class="text-xs text-[#8A8A85]">{run.datasetName} • {run.algorithmVersion}</p>
              </div>
            </div>
            <div class="text-right">
              {run.metrics ? (
                <>
                  <p class="text-sm font-mono font-medium text-[#111110]">{run.metrics.recallAt10.toFixed(3)}</p>
                  <p class="text-xs text-[#8A8A85]">Recall@10</p>
                </>
              ) : (
                <span class="text-xs text-[#8A8A85] capitalize">{run.status}</span>
              )}
            </div>
          </a>
        ))}
      </div>
      <div class="border-t border-black/[0.08] px-6 py-3">
        <a href="/app/runs" class="text-sm font-medium text-[#2563EB] hover:underline underline-offset-4">
          View all runs →
        </a>
      </div>
    </div>

    <!-- Leaderboard preview -->
    <div class="rounded-xl border border-black/[0.08] bg-white shadow-sm">
      <div class="border-b border-black/[0.08] px-6 py-4">
        <h2 class="text-base font-semibold text-[#111110]">Top Performers</h2>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-black/[0.08] bg-[#F7F7F5]">
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-[#8A8A85]">Rank</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-[#8A8A85]">Algorithm</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-[#8A8A85]">Dataset</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-[#8A8A85]">Score</th>
          </tr>
        </thead>
        <tbody>
          {topLeaderboard.map((entry, i) => (
            <tr class={`border-b border-black/[0.06] ${i % 2 === 0 ? "bg-white" : "bg-[#FAFAF8]"}`}>
              <td class="px-6 py-3.5">
                <span class={`inline-flex size-6 items-center justify-center rounded-full text-xs font-medium ${
                  entry.rank === 1 ? "bg-[#FEF3C7] text-[#92400E]" :
                  entry.rank === 2 ? "bg-[#F3F4F6] text-[#374151]" :
                  entry.rank === 3 ? "bg-[#FEF3C7] text-[#92400E]" :
                  "text-[#8A8A85]"
                }`}>
                  {entry.rank}
                </span>
              </td>
              <td class="px-6 py-3.5 font-medium text-[#111110]">{entry.sdk}</td>
              <td class="px-6 py-3.5 text-[#4B4B48]">{entry.dataset}</td>
              <td class="px-6 py-3.5 font-mono text-[#111110]">{entry.score.toFixed(3)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="border-t border-black/[0.08] px-6 py-3">
        <a href="/app/leaderboard" class="text-sm font-medium text-[#2563EB] hover:underline underline-offset-4">
          View full leaderboard →
        </a>
      </div>
    </div>
  </div>
</AppLayout>
