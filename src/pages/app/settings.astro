---
import AppLayout from "@/layouts/AppLayout.astro";

const sections = [
  {
    title: "Profile",
    description: "Manage your personal information and preferences.",
    icon: (
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
      </svg>
    ),
    href: "/app/settings/profile",
  },
  {
    title: "API Keys",
    description: "Create and manage API keys for programmatic access.",
    icon: (
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
      </svg>
    ),
    href: "/app/settings/api-keys",
  },
  {
    title: "Billing",
    description: "View your plan, usage, and payment methods.",
    icon: (
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
      </svg>
    ),
    href: "/app/settings/billing",
  },
  {
    title: "Notifications",
    description: "Configure email and webhook notifications.",
    icon: (
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
      </svg>
    ),
    href: "/app/settings/notifications",
  },
  {
    title: "Integrations",
    description: "Connect GitHub, Slack, and other tools.",
    icon: (
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
      </svg>
    ),
    href: "/app/settings/integrations",
  },
  {
    title: "Team",
    description: "Manage team members and permissions.",
    icon: (
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
      </svg>
    ),
    href: "/app/settings/team",
  },
];
---

<AppLayout title="Settings - Skyboy">
  <div slot="breadcrumb">
    <nav class="flex items-center gap-2 text-sm">
      <a href="/app/dashboard" class="text-[#8A8A85] hover:text-[#111110]">Dashboard</a>
      <span class="text-[#8A8A85]">/</span>
      <span class="font-medium text-[#111110]">Settings</span>
    </nav>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-[#111110]">Settings</h1>
    <p class="mt-1 text-sm text-[#4B4B48]">Manage your account and application preferences.</p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {sections.map((section) => (
      <a
        href={section.href}
        class="group rounded-xl border border-black/[0.08] bg-white p-6 shadow-sm transition hover:border-black/[0.16] hover:shadow-md"
      >
        <div class="flex size-10 items-center justify-center rounded-lg bg-[#F7F7F5] text-[#2563EB] group-hover:bg-[#2563EB] group-hover:text-white">
          {section.icon}
        </div>
        <h3 class="mt-4 text-base font-semibold text-[#111110]">{section.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[#4B4B48]">{section.description}</p>
        <div class="mt-4 flex items-center text-sm font-medium text-[#2563EB]">
          Configure
          <svg class="ml-1 size-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</AppLayout>
