---
---

<section id="early-access" class="bg-white py-24 md:py-32">
  <div class="skyboy-container">
    <div class="mx-auto grid max-w-xl justify-items-center text-center gap-6">
      <h2 class="text-4xl font-semibold tracking-tight text-[#111110] md:text-5xl">
        Get early access
      </h2>
      <p class="text-base leading-relaxed text-[#4B4B48]">
        Join researchers and teams already benchmarking on Skyboy.
      </p>

      <form
        class="mt-2 flex w-full max-w-sm flex-col gap-3 sm:flex-row"
        onsubmit="event.preventDefault()"
      >
        <input
          type="email"
          placeholder="your@email.com"
          required
          class="h-10 flex-1 rounded-lg border border-black/[0.12] bg-[#F7F7F5] px-4 text-sm text-[#111110] placeholder:text-[#8A8A85] focus:border-[#2563EB] focus:outline-none focus:ring-2 focus:ring-[#2563EB]/20"
        />
        <button
          type="submit"
          class="inline-flex h-10 items-center justify-center rounded-lg bg-[#111110] px-5 text-sm font-medium text-white transition hover:bg-[#2a2a28] whitespace-nowrap"
        >
          Request access
        </button>
      </form>

      <p class="text-xs text-[#8A8A85]">No credit card required &middot; Free for public projects</p>
    </div>
  </div>
</section>
