---
import { footerLinks, socialLinks } from "@/lib/constants";
import { siteCopy } from "@/content/copy";
---

<footer class="border-t border-white/[0.08] py-10">
  <div class="skyboy-container flex flex-col gap-6 text-sm text-skyboy-text-secondary md:flex-row md:items-center md:justify-between">
    <p>{siteCopy.name}</p>
    <nav aria-label="Footer links" class="flex gap-4">
      {[...footerLinks, ...socialLinks].map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>
