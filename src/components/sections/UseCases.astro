---
import GlowCard from "@/components/shared/GlowCard.astro";

const useCases = [
  {
    audience: "AI Startups",
    description:
      "Build retrieval, ranking, or agent systems without hiring a platform team first. Skyboy gives small teams the evaluation infrastructure they need from day one.",
    icon: "rocket",
  },
  {
    audience: "Research Labs",
    description:
      "Run reproducible experiments and track benchmarks without building tooling from scratch. Keep every dataset, metric, and result attached to the work that produced it.",
    icon: "microscope",
  },
  {
    audience: "Enterprise AI Teams",
    description:
      "Evaluate proprietary algorithms across products with governance, security, and shared visibility. Reduce duplicated tooling while keeping each team moving independently.",
    icon: "building",
  },
  {
    audience: "Open Source Maintainers",
    description:
      "Give retrieval, ranking, and agent framework communities standardized public evaluation they can trust. Publish comparable results without asking contributors to recreate your setup.",
    icon: "code",
  },
] as const;
---

<section id="use-cases" class="skyboy-section">
  <div class="skyboy-container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium text-skyboy-success">Who it's for</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-normal text-skyboy-text md:text-5xl">
        Built for every team evaluating algorithms at scale
      </h2>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      {
        useCases.map((useCase) => (
          <GlowCard class="group flex min-h-72 flex-col transition duration-200 hover:-translate-y-1">
            <div class="flex size-12 items-center justify-center rounded-xl border border-white/[0.08] bg-white/[0.04] text-skyboy-text">
              {useCase.icon === "rocket" && (
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4.5 16.5c-1.5 1.26-2 4-2 4s2.74-.5 4-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z" />
                  <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z" />
                  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
                  <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                </svg>
              )}
              {useCase.icon === "microscope" && (
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 18h8" />
                  <path d="M3 22h18" />
                  <path d="M14 22a7 7 0 1 0 0-14h-1" />
                  <path d="M9 14h2" />
                  <path d="M8 6h4" />
                  <path d="m8 10 2-4 2 4" />
                  <path d="M10 6V3" />
                </svg>
              )}
              {useCase.icon === "building" && (
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="16" height="20" x="4" y="2" rx="2" ry="2" />
                  <path d="M9 22v-4h6v4" />
                  <path d="M8 6h.01" />
                  <path d="M16 6h.01" />
                  <path d="M12 6h.01" />
                  <path d="M12 10h.01" />
                  <path d="M12 14h.01" />
                  <path d="M16 10h.01" />
                  <path d="M16 14h.01" />
                  <path d="M8 10h.01" />
                  <path d="M8 14h.01" />
                </svg>
              )}
              {useCase.icon === "code" && (
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m16 18 6-6-6-6" />
                  <path d="m8 6-6 6 6 6" />
                </svg>
              )}
            </div>

            <div class="mt-6 flex flex-1 flex-col">
              <h3 class="text-xl font-semibold text-skyboy-text">{useCase.audience}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-skyboy-text-secondary">{useCase.description}</p>
              <a href="#pricing" class="mt-6 inline-flex w-fit items-center gap-2 text-sm font-medium text-skyboy-text transition hover:text-skyboy-success">
                Learn more
                <span aria-hidden="true">-&gt;</span>
              </a>
            </div>
          </GlowCard>
        ))
      }
    </div>
  </div>
</section>
