---
const logos = [
  "NORTHBEAM",
  "QUILL AI",
  "RETRIEVA",
  "ARGON LABS",
  "MERIDIAN",
  "STACKWELL",
];
---

<section class="py-12 md:py-16" aria-label="Trusted by placeholder teams">
  <div class="skyboy-container">
    <p class="mx-auto max-w-2xl text-center text-sm text-skyboy-text-muted">
      Built for teams shipping retrieval, ranking, and reasoning systems
    </p>

    <div
      class="mt-8 flex gap-4 overflow-x-auto pb-2 sm:flex-wrap sm:justify-center sm:overflow-visible sm:pb-0"
    >
      {
        logos.map((logo) => (
          <div class="flex h-10 min-w-36 shrink-0 items-center justify-center px-4 font-mono text-xs font-medium tracking-[0.18em] text-skyboy-text-secondary opacity-50 grayscale transition duration-200 ease-out hover:text-skyboy-text hover:opacity-100 hover:grayscale-0 sm:min-w-40">
            {logo}
          </div>
        ))
      }
    </div>
  </div>
</section>
