---
type Status = "yes" | "no" | "partial";

const columns = ["Skyboy", "GitHub Actions", "Hugging Face", "Weights & Biases", "Braintrust", "LangSmith"] as const;

const rows: {
  capability: string;
  values: Record<(typeof columns)[number], { status: Status; note?: string }>;
}[] = [
  {
    capability: "Algorithm versioning",
    values: {
      Skyboy: { status: "yes" },
      "GitHub Actions": { status: "yes", note: "code only" },
      "Hugging Face": { status: "yes", note: "models only" },
      "Weights & Biases": { status: "partial" },
      Braintrust: { status: "no" },
      LangSmith: { status: "no" },
    },
  },
  {
    capability: "Benchmark orchestration",
    values: {
      Skyboy: { status: "yes" },
      "GitHub Actions": { status: "no", note: "BYO" },
      "Hugging Face": { status: "no" },
      "Weights & Biases": { status: "partial" },
      Braintrust: { status: "partial", note: "LLM-focused" },
      LangSmith: { status: "partial", note: "agent-focused" },
    },
  },
  {
    capability: "Dataset registry",
    values: {
      Skyboy: { status: "yes" },
      "GitHub Actions": { status: "no" },
      "Hugging Face": { status: "yes" },
      "Weights & Biases": { status: "partial" },
      Braintrust: { status: "partial" },
      LangSmith: { status: "no" },
    },
  },
  {
    capability: "Baseline comparison",
    values: {
      Skyboy: { status: "yes" },
      "GitHub Actions": { status: "no" },
      "Hugging Face": { status: "partial" },
      "Weights & Biases": { status: "partial" },
      Braintrust: { status: "partial" },
      LangSmith: { status: "partial" },
    },
  },
  {
    capability: "Regression detection",
    values: {
      Skyboy: { status: "yes" },
      "GitHub Actions": { status: "yes", note: "CI only, not metric-aware" },
      "Hugging Face": { status: "no" },
      "Weights & Biases": { status: "no" },
      Braintrust: { status: "no" },
      LangSmith: { status: "no" },
    },
  },
  {
    capability: "Deployment packaging",
    values: {
      Skyboy: { status: "yes" },
      "GitHub Actions": { status: "partial" },
      "Hugging Face": { status: "yes", note: "model hosting" },
      "Weights & Biases": { status: "no" },
      Braintrust: { status: "no" },
      LangSmith: { status: "no" },
    },
  },
  {
    capability: "Purpose-built for algorithm evaluation",
    values: {
      Skyboy: { status: "yes" },
      "GitHub Actions": { status: "partial" },
      "Hugging Face": { status: "partial" },
      "Weights & Biases": { status: "partial" },
      Braintrust: { status: "partial" },
      LangSmith: { status: "partial" },
    },
  },
];

const statusLabel = {
  yes: "Included",
  no: "Not included",
  partial: "Partial",
} satisfies Record<Status, string>;
---

<section id="comparison" class="skyboy-section">
  <div class="skyboy-container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium text-skyboy-success">Comparison</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-normal text-skyboy-text md:text-5xl">
        Why not just use what you already have?
      </h2>
    </div>

    <div class="mt-14 overflow-x-auto rounded-2xl border border-white/[0.08] bg-white/[0.03]">
      <table class="min-w-[980px] w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-white/[0.08]">
            <th class="w-64 bg-skyboy-background/95 px-5 py-4 font-medium text-skyboy-text-muted">Capability</th>
            {
              columns.map((column) => (
                <th
                  class:list={[
                    "min-w-36 px-4 py-4 font-medium text-skyboy-text",
                    column === "Skyboy" &&
                      "sticky left-64 z-20 border-x border-skyboy-blue/20 bg-skyboy-background shadow-[0_0_32px_rgba(59,130,246,0.14)]",
                  ]}
                >
                  {column}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-white/[0.06] last:border-b-0">
                <th class="sticky left-0 z-10 w-64 bg-skyboy-background/95 px-5 py-4 font-medium text-skyboy-text">
                  {row.capability}
                </th>
                {columns.map((column) => {
                  const value = row.values[column];
                  return (
                    <td
                      class:list={[
                        "px-4 py-4 align-top text-skyboy-text-secondary",
                        column === "Skyboy" &&
                          "sticky left-64 z-10 border-x border-skyboy-blue/20 bg-gradient-to-br from-skyboy-blue/12 via-skyboy-purple/8 to-skyboy-cyan/10 text-skyboy-text",
                      ]}
                    >
                      <div class="flex min-h-10 items-start gap-2">
                        <span
                          class:list={[
                            "mt-0.5 inline-flex size-5 shrink-0 items-center justify-center",
                            value.status === "yes" && "text-skyboy-success",
                            value.status === "no" && "text-skyboy-warning",
                            value.status === "partial" && "text-skyboy-text-muted",
                          ]}
                          aria-label={statusLabel[value.status]}
                        >
                          {value.status === "yes" && (
                            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M20 6 9 17l-5-5" />
                            </svg>
                          )}
                          {value.status === "no" && (
                            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M18 6 6 18" />
                              <path d="m6 6 12 12" />
                            </svg>
                          )}
                          {value.status === "partial" && (
                            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="12" cy="12" r="9" />
                              <path d="M8 12h8" />
                            </svg>
                          )}
                        </span>
                        <span class="leading-6">
                          {value.status === "yes" ? "Yes" : value.status === "no" ? "No" : "Partial"}
                          {value.note && <span class="block text-xs text-skyboy-text-muted">{value.note}</span>}
                        </span>
                      </div>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
