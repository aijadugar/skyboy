{
  "name": "@skyboy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The Skyboy desktop app: a React interface over a Rust core.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:hook": "node scripts/prepare-hook.mjs",
    "prepare:hook:debug": "node scripts/prepare-hook.mjs --debug",
    "generate:sounds": "node scripts/generate-sounds.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "dev": "node scripts/prepare-hook.mjs --debug && vite",
    "build": "node scripts/prepare-hook.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@skyboy/design-tokens": "*",
    "@tauri-apps/api": "^2.12.5",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
