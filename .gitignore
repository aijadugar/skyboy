# Dependencies
node_modules/

# Next.js
.next/
out/
build/

# Emitted build output
dist/

# Rust. The workspace hoists `target/` to the repository root, so one entry
# covers every crate.
target/

# The hook binary copied into the bundle by apps/desktop/scripts/prepare-hook.mjs.
# It is a build artifact of `cargo build -p skyboy-hook`, not source.
apps/desktop/core/binaries/

# Generated by tauri-build: capability schemas, and the icons `tauri icon`
# derives from the source PNG.
apps/desktop/core/gen/

# The design-input repos are vendored separately (each keeps its own git history)
drawably/
taste-skill/
awesome-design-md/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env & secrets
.env
.env.*
# `.env *` catches duplicates and editor backups such as `.env copy` or `.env 2`.
.env *
!.env.example
.DS_Store

# Editor
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts
